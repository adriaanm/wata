<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A paid-program App ID capability (a portal checkbox, no request
	     form). See ../README.md. -->
	<key>com.apple.developer.push-to-talk</key>
	<true/>
	<!-- PTChannelManager instantiation fails with PTInstantiationError
	     code 3 (missingPushServerEnvironment) without this: incoming talk
	     arrives as APNs pushes, so the framework demands a push
	     environment even before any push is used. Seen on device
	     2026-08-17. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>application-identifier</key>
	<string>TEAM_ID.BUNDLE_ID</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TEAM_ID</string>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
